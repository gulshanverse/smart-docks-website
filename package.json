{
  "name": "smartdocs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "ai:gateway": "node server/ai-gateway.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "latest",
    "fflate": "0.8.3",
    "lucide-react": "latest",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
