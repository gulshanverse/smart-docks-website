{
  "name": "smartdocs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host",
    "ai:gateway": "node server/ai-gateway.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "fflate": "0.8.3",
    "lucide-react": "1.34.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0"
  }
}
